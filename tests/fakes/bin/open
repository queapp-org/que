#!/usr/bin/env node
// Fake macOS `open` for que's tests (an editor app with `-a`, a link): records the
// call and opens nothing. QUE_FAKE_OPEN_FAIL makes it fail with that message.
'use strict'

const fs = require('node:fs')

const log = process.env.QUE_FAKE_OPEN_LOG
if (log) {
  const entry = { argv: process.argv.slice(2), cwd: process.cwd(), ts: new Date().toISOString() }
  fs.appendFileSync(log, `${JSON.stringify(entry)}\n`)
}

const fail = process.env.QUE_FAKE_OPEN_FAIL
if (fail) {
  process.stderr.write(`${fail}\n`)
  process.exitCode = 1
} else process.exitCode = 0
