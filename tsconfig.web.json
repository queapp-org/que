{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "types": [],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "composite": true,
    "noEmit": true,
    "paths": {
      "@shared/*": ["./src/shared/*"],
      "@renderer/*": ["./src/renderer/src/*"]
    }
  },
  "include": [
    "src/renderer/src/**/*",
    "src/preload/index.d.ts",
    "src/daemon/quiet-hours.ts",
    "src/daemon/report.ts",
    "src/shared/config-defaults.ts",
    "src/shared/count-line.ts",
    "src/shared/diff-parse.ts",
    "src/shared/config-keys.decode.ts",
    "src/shared/config-patch.decode.ts",
    "src/shared/errors.decode.ts",
    "src/shared/format.ts",
    "src/shared/json.decode.ts",
    "src/shared/pr-url.ts",
    "src/shared/preparation.ts",
    "src/shared/protocol.ts",
    "src/shared/quiet-board.ts",
    "src/shared/removal.ts",
    "src/shared/sh-quote.ts",
    "src/shared/slug.ts",
    "src/shared/brief.ts",
    "src/shared/names.ts",
    "src/shared/types.ts",
    "src/shared/unicode-width.ts",
    "src/shared/usage.ts",
    "src/testing/entities.ts"
  ]
}
